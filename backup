* {
    box-sizing: border-box;
}

body {
    font-family: 'Poppins', sans-serif;
}


nav {
    display: flex;
    background-color: #1E2A56;
    justify-content: center;
    align-items: center;
    width: 100%;
    height: 10vh;
}
nav h1 {
    flex: 5;
    margin-left: 20px;
    color: #fff;
}
nav .login-and-signup {
    display: flex;
    align-items: center;
    gap: 30px;
    padding: 10px;
    flex: 1;
}
button {
    border: none;
    background-color: blue;
    padding: 10px 5px;
    width: 100px;
    color: #fff;
    border-radius: 10px;
    font-weight: 700;
}
button:hover {
    background-color: lightblue;
    color: black;
    cursor: pointer;
    transform: scale(1.1);
    transition: 0.5s;
}
nav .right-section {
    display: flex;
    align-items: center;
    gap: 20px;
    padding: 10px;
}
.right-section .menu-icon {
    font-size: 30px;
    color: #fff;
    cursor: pointer;
}
.sidebar {
    position: fixed;
    top: 0;
    right: -250px;
    width: 250px;
    height: 100%;
    background-color: #1E2A56;
    color: white;
    transition: right 0.3s ease;
    padding-top: 60px;
    z-index: 1;
}
.sidebar.active {
    right: 0;
}
.sidebar a {
    display: block;
    padding: 15px;
    text-decoration: none;
    color: white;
}
.sidebar a:hover {
    background-color: lightblue;
    color: black;
}
.close {
    position: absolute;
    font-size: 20px;
    color: white;
    text-decoration: none;
    width: 100%;
    top: 10px;
}
.profile-pic {
    width: 35px;
    height: 35px;
    border-radius: 50%;
    background-color: white;
    cursor: pointer;
}



/* --- Mobile Responsiveness --- */
@media (max-width: 768px) {
    
    /* 1. Make the main containers full width */
    .wrapper, .settings-container, .reset-container {
        width: 95%; /* Use percentage instead of fixed px */
        max-width: none;
        margin: 20px auto;
        padding: 20px;
    }

    /* 2. Fix the Layout on Saved Locations page */
    .main-container {
        flex-direction: column; /* Stack the list on top of the map/details */
    }

    .locations-list {
        width: 100%; /* Take up full width on mobile */
        max-width: none;
        height: auto;
        max-height: 300px; /* Limit height so it doesn't push the map too far down */
        overflow-y: scroll;
    }

    .details-panel {
        padding: 10px;
        flex-direction: column; /* Stack the weather card and map */
    }

    .weather-card, .map {
        width: 100%;
        min-height: 300px;
    }

    /* 3. Adjust Navigation */
    nav {
        padding: 0 15px;
    }

    h2 {
        font-size: 1.5rem; /* Smaller headers for smaller screens */
    }

    /* 4. Make buttons easier to tap */
    button {
        width: 100%;
        padding: 15px;
        font-size: 18px;
    }
}
        